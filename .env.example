# MeetingMind AI Environment Configuration
# Copy this file to .env for local development

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Provider Configuration
# Set to 'gemini', 'openai_compatible', or 'mock'
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY will be automatically provided in AI Studio or can be set manually
GEMINI_API_KEY=

# OpenAI Compatible API (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Jira Cloud Integration (Optional - can also be configured per workspace in UI)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=user@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DEFAULT_PROJECT_KEY=PROJ

# Notion Integration (Optional - can also be configured per workspace in UI)
NOTION_API_KEY=secret_notion_api_key
NOTION_DEFAULT_DATABASE_ID=your_notion_database_id

# Email & Notifications (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@meetingmind.ai

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=

# n8n Automation (Optional)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=n8n-shared-webhook-secret-token

# Upload Limits
MAX_UPLOAD_SIZE_MB=10
